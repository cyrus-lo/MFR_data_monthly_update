# Step 4 Snowflake Task Graph connection
SF_USER=your_service_user
# Normal Snowflake password, matching Step 3. Do not put an OAuth/JWT token here.
SF_PASSWORD=your_normal_snowflake_password
SF_ACCOUNT=your_account_identifier
SF_ROLE=your_role
SF_WAREHOUSE=your_warehouse
SF_DATABASE=CHUNWO_DB
SF_SCHEMA=PUBLIC
# Comma-separated fully qualified task names. Tasks may use different schemas.
# SF_TASK_NAME remains supported for backward compatibility when only one task is required.
SF_TASK_NAMES=CHUNWO_DB.PUBLIC.TASK_MFR_EXCEL_TO_TABLE_MFR_PARALLEL,CHUNWO_DB.MFR_POC.TASK_TEST_API_TRIGGER
# sequential: run in listed order and stop before the next task after failure
# parallel: trigger all independent tasks, then monitor them together
SF_TASK_EXECUTION_MODE=sequential
# Optional generic A -> B transition rules. Enabled rules require sequential mode.
# The supplied example checks the successful Step 3 project set after Task A and before Task B.
SF_TASK_POSTCHECKS_FILE=task_postchecks.json
