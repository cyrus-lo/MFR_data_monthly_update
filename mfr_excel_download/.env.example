# CIS MFR report endpoint. Both placeholders are required.
CIS_MFR_REPORT_URL_TEMPLATE=https://cis.chunwo.com:8083/reports/service/api/FinanceReportApi/GetMFRReportFile?ProjectID={project_id}&ReportMonth={reporting_month}
# Network timeout per project download, in seconds.
CIS_REQUEST_TIMEOUT_SECONDS=120
