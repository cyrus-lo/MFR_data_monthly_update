# Copy this file to .env and replace the placeholder values locally.
# Never commit .env or real credentials.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=your-database-name

# The reporting month is supplied at runtime with --param YYYY-MM-DD.
# The completion check expects 20 projects by default; override only with
# --expected-project-count when the approved target-project list changes.